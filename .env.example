# Kestrel reads these from real environment variables; it does not load this file.
# Copy the lines you need into your shell or deployment settings.

# "local" on your own machine, "hosted" on a server. Unset means hosted, which
# blocks localhost and private-network addresses in Test connection.
KESTREL_MODE=local

# Required for hosted mode: the API is fail-closed when KESTREL_MODE is unset or
# "hosted", so every request must send an X-Kestrel-Token header matching this
# value. The Streamlit UI reads the same variable and sends it. Unused in local mode.
# KESTREL_API_TOKEN=

# Optional Fernet key for encrypting auth header values. When unset, Kestrel uses
# (or creates) the key file below and logs where it is. Back that file up.
# KESTREL_SECRET_KEY=

# Key file used when KESTREL_SECRET_KEY is unset.
# KESTREL_KEY_FILE=~/.kestrel/secret.key

# SQLite database. Default data/kestrel.db under the repo root; a relative path
# resolves against the repo root.
# KESTREL_DB_PATH=data/kestrel.db

# Where the Streamlit screen finds the API.
# KESTREL_API_URL=http://127.0.0.1:8000

# The judge that decides whether an attack worked when no canary matched.
# It is optional: without a key, canary evidence still settles runs and
# judged runs end "unclear" instead of failing.
# KESTREL_JUDGE_MODEL=google/gemini-3.8-flash
# KESTREL_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# KESTREL_JUDGE_API_KEY=            # falls back to OPENROUTER_API_KEY
# OPENROUTER_API_KEY=

# The attacker model that drives an adaptive (multi-turn) attack (feature 003).
# Optional: single-turn attacks and canary evidence work without it; an adaptive
# run needs an attacker key. Defaults to a current DeepSeek model via OpenRouter.
# Note: some OpenRouter accounts have a guardrail that blocks older DeepSeek slugs
# (e.g. deepseek-v3.2) with a 404; the v4 line below is the current, permitted one.
# KESTREL_ATTACKER_MODEL=deepseek/deepseek-v4.1-flash
# KESTREL_ATTACKER_BASE_URL=https://openrouter.ai/api/v1
# KESTREL_ATTACKER_API_KEY=         # falls back to OPENROUTER_API_KEY

# Hard caps on an adaptive run (Principle VIII, bounded harm).
# KESTREL_ADAPTIVE_MAX_TURNS=6
# KESTREL_ADAPTIVE_TOKEN_BUDGET=40000     # attacker + judge tokens across the whole run
# KESTREL_ADAPTIVE_TIME_LIMIT_S=300       # wall-clock backstop

# The experience store (feature 004): a local ChromaDB of attack patterns and
# per-target memory, next to the database. Embeddings run locally (no API).
# KESTREL_CHROMA_PATH=data/chroma
# KESTREL_EXPERIENCE_PATTERN_K=5          # similar patterns retrieved per warm turn
# KESTREL_EXPERIENCE_MEMORY_CAP=10        # this target's memory records shown to the attacker

# Retrieval controls (feature 011), both on by default. Distances are the collection's
# own l2 (squared Euclidean) measure between normalised embeddings, 0 (identical) to 4.
# KESTREL_EXPERIENCE_DISTANCE_FLOOR=1.8    # drop hits farther than this from the query; "off" disables
# KESTREL_EXPERIENCE_DEDUPE_THRESHOLD=0.15 # hits or successes at or below this distance are near-identical
#                                         # (one hint per approach; a repeated success raises the pattern's
#                                         # hit count instead of adding a copy); "off" disables
# Both values are tuned for the shipped embedding model (all-MiniLM-L6-v2). A different
# embedding model needs retuned values and a rebuilt store directory. The floor is a
# measured default, not a guarantee: from turn 4 the query no longer contains the seed,
# and such a query may occasionally select nothing - visible on the memory.retrieval log
# line as pattern_count 0 with a non-zero dropped_floor. Raise or lower the floor from
# the distances and dropped_floor those lines log.

# A/B experiment harness (feature 007): one blended USD price per 1,000 tokens per
# model, used only to turn token counts into a cost estimate. Format "model=price,model=price";
# without it an experiment reports cost as "unavailable". Source: OpenRouter pricing, Nov 2026
# (per 1M tokens) - deepseek/deepseek-v4.1-flash $0.0348 in / $0.1392 out (promotional; regular
# $0.15 / $0.60); google/gemini-3.8-flash $0.75 in / $3.75 out. Blended to one per-1k price:
# deepseek 0.00006, gemini 0.0015.
# KESTREL_MODEL_PRICES=deepseek/deepseek-v4.1-flash=0.00006,google/gemini-3.8-flash=0.0015

# Regression replay (feature 012): the most replayable runs a single batch replay will
# process for one target. A target with more than this many refuses the whole batch
# before sending anything. Reported on GET /api/config.
# KESTREL_REPLAY_BATCH_MAX_RUNS=20

# Behavioural evidence (feature 013). The canary callback listener is a route on the
# Kestrel API itself (/callback/{token}): the public base URL at which a target can
# reach that route, ending in /callback. Part 1 of the feature validates this setting
# at start-up (an http or https URL without credentials, or Kestrel refuses to start)
# and reports on GET /api/config whether the listener route is mounted; the route
# itself, and the planting it enables, arrive with part 2 - until then the listener is
# reported off whatever this is set to. Unset = disabled: nothing is planted and no
# callback check runs. A loopback or private base is only ever planted into a run
# against a target it can actually reach.
# KESTREL_CALLBACK_BASE_URL=http://127.0.0.1:8000/callback
# How long a run that planted a callback URL waits after each reply for a hit, in
# seconds (0 = check once, never sleep); always bounded by the run's own time limit.
# KESTREL_CALLBACK_WAIT_S=2
# The timeout of one request to a target's side channel (descriptor, tool-call log,
# state snapshot), in whole seconds.
# KESTREL_SIDE_CHANNEL_TIMEOUT_S=10

# Structured logging (feature 010). Every line Kestrel writes to stderr is one JSON
# object (run, turn, model request, target request, ...); "text" renders the same
# fields as "ts level event key=value ..." for local reading. The prices above also
# give every model-request line its estimated cost.
# KESTREL_LOG_FORMAT=json                 # json (default) | text

# Optional OpenTelemetry traces (feature 010): one trace per run, off by default.
# Needs the optional extra: uv sync --extra otel (the dev group already has it).
# Without the extra, "on" logs one tracing.unavailable warning and runs untraced.
# KESTREL_TRACING=off                     # on | off
# The standard OpenTelemetry variables configure the collector; Kestrel overrides
# none of them. Unset endpoint = the protocol's default local address.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_TIMEOUT=10           # seconds, as the Python OTLP/HTTP exporter reads it
# OTEL_SERVICE_NAME=kestrel               # the service name on every span (default kestrel)

# Sacrificial HS-code target only: the canary placed in its system prompt.
# Declare the same value as a canary on the target inside Kestrel.
# HS_TARGET_CANARY=KESTREL-CANARY-7Q4M2X
