# Kestrel reads these from real environment variables; it does not load this file.
# Copy the lines you need into your shell or deployment settings.

# "local" on your own machine, "hosted" on a server. Unset means hosted, which
# blocks localhost and private-network addresses in Test connection.
KESTREL_MODE=local

# Optional Fernet key for encrypting auth header values. When unset, Kestrel uses
# (or creates) the key file below and logs where it is. Back that file up.
# KESTREL_SECRET_KEY=

# Key file used when KESTREL_SECRET_KEY is unset.
# KESTREL_KEY_FILE=~/.kestrel/secret.key

# SQLite database. Default data/kestrel.db under the repo root; a relative path
# resolves against the repo root.
# KESTREL_DB_PATH=data/kestrel.db

# Where the Streamlit screen finds the API.
# KESTREL_API_URL=http://127.0.0.1:8000

# The judge that decides whether an attack worked when no canary matched.
# It is optional: without a key, canary evidence still settles runs and
# judged runs end "unclear" instead of failing.
# KESTREL_JUDGE_MODEL=google/gemini-3.8-flash
# KESTREL_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# KESTREL_JUDGE_API_KEY=            # falls back to OPENROUTER_API_KEY
# OPENROUTER_API_KEY=

# The attacker model that drives an adaptive (multi-turn) attack (feature 003).
# Optional: single-turn attacks and canary evidence work without it; an adaptive
# run needs an attacker key. Defaults to a DeepSeek model via OpenRouter.
# KESTREL_ATTACKER_MODEL=deepseek/deepseek-v3.2
# KESTREL_ATTACKER_BASE_URL=https://openrouter.ai/api/v1
# KESTREL_ATTACKER_API_KEY=         # falls back to OPENROUTER_API_KEY

# Hard caps on an adaptive run (Principle VIII, bounded harm).
# KESTREL_ADAPTIVE_MAX_TURNS=6
# KESTREL_ADAPTIVE_TOKEN_BUDGET=40000     # attacker + judge tokens across the whole run
# KESTREL_ADAPTIVE_TIME_LIMIT_S=300       # wall-clock backstop

# Sacrificial HS-code target only: the canary placed in its system prompt.
# Declare the same value as a canary on the target inside Kestrel.
# HS_TARGET_CANARY=KESTREL-CANARY-7Q4M2X
